{
  "name": "cogniease-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CogniEase - Neurodivergent & Accessible Reading Assistant Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "test": "node --test packages/core/test/core.test.js"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.21.5"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag-aaa",
    "dyslexia",
    "adhd",
    "bionic-reading",
    "text-to-speech",
    "monorepo",
    "neurodiversity"
  ],
  "author": "CogniEase Team",
  "license": "MIT"
}
